{
  "name": "asif-digital-sovereign",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "server": "tsx server.ts",
    "worker:discovery": "tsx workers/discovery_worker.ts",
    "worker:enrichment": "tsx workers/enrichment_worker.ts",
    "worker:linkedin": "tsx workers/linkedin_worker.ts",
    "worker:drafts": "tsx workers/drafts_worker.ts",
    "worker:outreach": "tsx workers/outreach_worker.ts",
    "dashboard": "vite",
    "dev": "concurrently \"npm run server\" \"npm run worker:discovery\" \"npm run worker:enrichment\" \"npm run worker:linkedin\" \"npm run worker:drafts\" \"npm run worker:outreach\" \"npm run dashboard\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check": "npx tsx test_suite.ts && vite build",
    "test:validation": "tsx --test contact_validation.test.ts",
    "fix": "npx kill-port 3006 3010"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "axios": "^1.13.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-it": "^1.6.4",
    "groq-sdk": "^0.3.3",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^0.363.0",
    "mailparser": "^3.7.1",
    "node-imap": "^0.9.6",
    "nodemailer": "^6.9.13",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^22.6.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sqlite3": "^5.1.7",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.1",
    "typescript": "^5.7.2"
  }
}
